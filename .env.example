# UFC-Predicts Environment Variables
# This file contains all environment variables needed for the application
# Copy this file to .env.local and fill in the values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection string (required)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/ufc-predicts"

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================

# SportsData.io API key for UFC data (recommended)
# Get your key at: https://sportsdata.io/developers/api-documentation/mma
SPORTSDATA_API_KEY=""

# RapidAPI key for UFC Data API (optional, used as fallback)
# Get your key at: https://rapidapi.com/dolphinnoirbusiness/api/ufc-data
RAPIDAPI_KEY=""

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================

# Upstash Redis connection details (recommended for production)
# Get your credentials at: https://upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Toggle caching functionality (default: true)
ENABLE_CACHE="true"

# =============================================================================
# AUTHENTICATION SETTINGS
# =============================================================================

# Clerk authentication keys (required)
# Get your keys at: https://clerk.dev/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Secret key for securing cron job endpoints (required)
# Generate a strong random string
CRON_SECRET="change-me-to-a-secure-random-string"

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Use mock data when API calls fail or keys aren't provided (default: false)
USE_MOCK_DATA="false"

# Disable web scraping functionality (default: false)
# Set to true if you're having issues with rate limiting
DISABLE_WEB_SCRAPING="false"

# Prefer cached data over fresh API calls (default: false)
# Set to true to reduce API usage and improve performance
PREFER_CACHED_DATA="false"

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================

# Base path for GitHub Pages deployment (leave empty for normal deployment)
NEXT_PUBLIC_BASE_PATH=""

# Vercel Cron indicator (set automatically by Vercel when running cron jobs)
VERCEL_CRON=""

# Enable bundle analysis during build (default: false)
ANALYZE="false"
